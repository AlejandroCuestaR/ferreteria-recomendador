# Capa de IA OPCIONAL: explica el combo recomendado en lenguaje natural.
# Si LLM_API_KEY queda vacío, el sistema usa una explicación por plantilla
# (el proyecto arranca igual, sin necesidad de configurar nada).
#
# Proveedores gratuitos compatibles con la API de OpenAI (chat/completions):
#   NVIDIA : LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#            LLM_MODEL=meta/llama-3.1-8b-instruct
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL=gemini-flash-lite-latest  (alias estable y rápido)
#
# Copia este archivo a backend/.env y pon tu clave en LLM_API_KEY.
# Config por defecto: Gemini (validada). Para NVIDIA, usa la línea de arriba.

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest
